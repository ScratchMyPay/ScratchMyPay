{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n2link.dev/schemas/workflow-intent-v1",
  "title": "RGB2link WorkflowIntent v1 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "template_id",
    "template_version",
    "environment",
    "parameters"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "environment": {
      "enum": [
        "mutinynet",
        "regtest"
      ]
    },
    "parameters": {
      "type": "object",
      "maxProperties": 16,
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean"
        ],
        "maxLength": 256
      }
    },
    "rationale": {
      "type": "string",
      "maxLength": 1000
    }
  }
}
