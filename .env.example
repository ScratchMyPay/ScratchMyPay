# RGB2link PowerEdge — example environment. Copy to `.env` (git-ignored) and fill locally.
# NEVER put a mnemonic, seed or private key in this file or in any committed file.
# Wallet mnemonics live only in git-ignored files under secrets/ (one per wallet role).

# Network: test networks only. Mainnet is rejected by the wallet service.
POWEREDGE_NETWORK=mutinynet

# Wallet-owner sidecars (one process per wallet datadir), loopback only
WALLET_A_URL=http://127.0.0.1:8711
WALLET_B_URL=http://127.0.0.1:8712
WALLET_A_DATADIR=./datadirs/payer
WALLET_B_DATADIR=./datadirs/recipient
WALLET_A_MNEMONIC_FILE=./secrets/payer.mnemonic
WALLET_B_MNEMONIC_FILE=./secrets/recipient.mnemonic
# Shared bearer token between n2link and the sidecars (generate locally: openssl rand -hex 32)
WALLET_API_TOKEN=

# Mutinynet indexer / RGB proxy (public test infrastructure)
ELECTRUM_URL=https://mutinynet.com/api
RGB_PROXY_URL=

# Local QVAC OpenAI-compatible server (no cloud fallback)
QVAC_BASE_URL=http://127.0.0.1:11435/v1
QVAC_MODEL=

# n2link
N2LINK_HOME=./.n2link
