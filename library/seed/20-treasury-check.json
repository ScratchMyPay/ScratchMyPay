{
 "name": "Pre-show treasury check",
 "description": "Every day at 17:00 (or on a button press), check with Tether WDK whether the treasury can cover tonight's payouts; one branch says OK, the other says TOP UP with the shortfall.",
 "tags": [
  "wdk",
  "treasury",
  "fees",
  "schedule"
 ],
 "examples": [
  "Check every day whether the treasury can cover tonight's 5 payouts",
  "Warn me if the treasury is too low for the show",
  "Daily money check with WDK"
 ],
 "draft": {
  "version": 1,
  "summary": "Daily treasury check: WDK balance, cost of tonight's payouts, OK or TOP UP",
  "nodes": [
   {
    "ref": "tick",
    "type": "inject",
    "name": "17:00 check",
    "x": 140,
    "y": 80,
    "config": {
     "props": [
      {
       "p": "payload"
      }
     ],
     "repeat": "",
     "crontab": "00 17 * * *",
     "once": false,
     "payload": "",
     "payloadType": "date"
    }
   },
   {
    "ref": "balance",
    "type": "wdk-balance",
    "name": "Treasury balance",
    "x": 330,
    "y": 80,
    "config": {}
   },
   {
    "ref": "cost",
    "type": "wdk-fee-quote",
    "name": "Cost of tonight",
    "x": 520,
    "y": 80,
    "config": {
     "payoutsTonight": 5,
     "speed": "normal"
    }
   },
   {
    "ref": "enough",
    "type": "switch",
    "name": "Enough?",
    "x": 700,
    "y": 80,
    "config": {
     "property": "payload.coverage.enough",
     "propertyType": "msg",
     "rules": [
      {
       "t": "true"
      },
      {
       "t": "false"
      }
     ],
     "checkall": "true",
     "repair": false,
     "outputs": 2
    }
   },
   {
    "ref": "ok",
    "type": "debug",
    "name": "Treasury OK",
    "x": 890,
    "y": 60,
    "config": {
     "active": true,
     "tosidebar": true,
     "console": false,
     "tostatus": true,
     "complete": "payload.coverage",
     "targetType": "msg"
    }
   },
   {
    "ref": "low",
    "type": "debug",
    "name": "TOP UP the treasury",
    "x": 910,
    "y": 110,
    "config": {
     "active": true,
     "tosidebar": true,
     "console": true,
     "tostatus": true,
     "complete": "payload.coverage",
     "targetType": "msg"
    }
   }
  ],
  "wires": [
   {
    "from": "tick",
    "output": 0,
    "to": "balance"
   },
   {
    "from": "balance",
    "output": 0,
    "to": "cost"
   },
   {
    "from": "cost",
    "output": 0,
    "to": "enough"
   },
   {
    "from": "enough",
    "output": 0,
    "to": "ok"
   },
   {
    "from": "enough",
    "output": 1,
    "to": "low"
   }
  ]
 }
}