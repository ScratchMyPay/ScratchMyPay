{
 "name": "Show-night dashboard",
 "description": "Live dashboard of the show: wallet balances (USDT, TUSDT, sats), payouts per hour and volume, time from approval to settled (p50/p90), last payouts, door revenue and passes per hour, treasury, network cost per payout, key boxes. Every 30 s; read-only. Open it at /poweredge-app/dashboard.",
 "tags": [
  "dashboard",
  "wallets",
  "payouts",
  "door",
  "treasury",
  "stats"
 ],
 "examples": [
  "Show me a dashboard with the sats in the wallets and payouts per hour",
  "Build a show-night dashboard",
  "Chart the door revenue and the treasury"
 ],
