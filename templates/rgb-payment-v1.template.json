{
  "notice": "Illustrative template manifest; NOT a deployable flows.json",
  "id": "rgb-payment-v1",
  "version": "1.0.0",
  "status": "design-only",
  "allowed_environments": [
    "mutinynet",
    "regtest"
  ],
  "capabilities": [
    "rgb.invoice.create",
    "rgb.plan.prepare",
    "approval.request",
    "rgb.send.once",
    "rgb.consignment.import",
    "rgb.settlement.refresh"
  ],
  "required_controls": [
    "approval-gate",
    "idempotency-journal",
    "settlement-reconcile"
  ],
  "slots": {
    "wallet_ref": {
      "type": "wallet-reference"
    },
    "asset_id": {
      "type": "rgb-contract-id"
    },
    "amount_base_units": {
      "type": "positive-integer"
    }
  },
  "nodes": [
    "http-in",
    "intent-validate",
    "rgb-invoice",
    "rgb-plan",
    "approval-gate",
    "rgb-send-once",
    "rgb-refresh",
    "receipt",
    "http-response"
  ],
  "digest": "TO_BE_COMPUTED_FROM_CANONICAL_APPROVED_TEMPLATE"
}
